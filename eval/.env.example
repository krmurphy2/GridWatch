# Offline RAG evaluation. Uses direct OpenAI unless the gateway is configured.
OPENAI_API_KEY="your-openai-api-key"
EVAL_MODEL="gpt-5.1"
EVAL_EMBEDDING_MODEL="text-embedding-3-small"

# Optional: route eval through the Vercel AI Gateway (same as the agent).
AI_GATEWAY_API_KEY=""
AI_GATEWAY_BASE_URL="https://ai-gateway.vercel.sh/v1"

# Needed to push the dataset (generate_dataset.py --push) and to pull it in
# run_eval.py (the default, non --local, path).
LANGSMITH_API_KEY="your-langsmith-api-key"
