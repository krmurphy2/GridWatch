# Direct OpenAI is used when no AI gateway is configured (e.g. local dev).
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-5.1"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Vercel AI Gateway (OpenAI-compatible). When AI_GATEWAY_API_KEY is set, all chat
# and embedding calls route through the gateway and model ids are provider-qualified
# automatically (e.g. openai/gpt-5.1). Leave unset to call OpenAI directly.
AI_GATEWAY_API_KEY=""
AI_GATEWAY_BASE_URL="https://ai-gateway.vercel.sh/v1"

# Qdrant vector store for RAG. Leave QDRANT_URL unset for local dev — rag.py then
# builds an in-memory index from agent/corpus on first use. In production, set
# these to a Qdrant Cloud cluster and run `uv run python ingest.py` once to build
# the collection (and again after the corpus changes).
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="gridwatch_security_guidance"
RAG_RETRIEVAL_K="4"

LANGSMITH_API_KEY="your-langsmith-api-key"
LANGSMITH_TRACING="true"
LANGSMITH_PROJECT="gridwatch-router-extraction"
