# Direct OpenAI is used when no AI gateway is configured (e.g. local dev).
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-5.1"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Vercel AI Gateway (OpenAI-compatible). When AI_GATEWAY_API_KEY is set, all chat
# and embedding calls route through the gateway and model ids are provider-qualified
# automatically (e.g. openai/gpt-5.1). Leave unset to call OpenAI directly.
AI_GATEWAY_API_KEY=""
AI_GATEWAY_BASE_URL="https://ai-gateway.vercel.sh/v1"

LANGSMITH_API_KEY="your-langsmith-api-key"
LANGSMITH_TRACING="true"
LANGSMITH_PROJECT="gridwatch-router-extraction"
